% Risk-based cost-benefit analysis of masonry structures considering progressive collapse under wall loss scenarios
\title{A Digital Twin Framework for Risk Assessment in Construction Scheduling: Integrating Monte Carlo and Bayesian Network Approaches}

\author[label1]{Nilson Jorge Leão Junior}
\author[label1]{Wanderlei Malaquias Pereira Junior}
\author[label3]{Henrique Caetano}
\author[label1]{Marcos Napoleão Rabelo}
\author[label2]{Toni Esteves}
\author[label4]{Marcos Luiz Henrique}
\author[label5]{Hebert Kimura}
\author[label3]{Carlos Maciel}

\address[label1]{Federal University of Catalão – UFCAT, Catalão, 75701-180, Goiás, Brazil}
\address[label2]{Faculdade de Engenharia, Universidade Federal de Catalão, Catalão 75705-220, Goiás, Brasil}
\address[label3]{Faculdade de Engenharia, Universidade Federal de Catalão, Catalão 75705-220, Goiás, Brasil}
\address[label4]{NICEN - Interdisciplinary Center for Exact and Natural Sciences - CA, Caruaru, 55014-900, Pernambuco, Brazil}
\address[label5]{Department of Civil Engineering and Georesources, Porto, 4200-465, Portugal}

\begin{abstract}
The construction sector remains one of the world's largest industries, yet it faces persistent challenges related to schedule delays and cost overruns due to its dynamic and uncertain nature. This paper proposes a Digital Twin framework for risk assessment in construction scheduling by integrating traditional PERT/CPM methods with probabilistic approaches, specifically Monte Carlo simulation and Bayesian Networks. Unlike traditional deterministic models, the proposed methodology incorporates financial risk management metrics—Value-at-Risk (VaR) and Conditional Value-at-Risk ($CVaR$)—to provide a realistic analysis of the project makespan variability. The system was implemented using a Python-based client-server architecture with a Streamlit web interface, enabling dynamic updates through real-time evidence propagation.  The study concludes that the Digital Twin approach provides robust decision support, allowing managers to quantify risks and anticipate the impact of early task variations on final deadlines.
\end{abstract}

\begin{keyword}
Digital Twin \sep Bayesian Networks \sep Risk Management \sep Construction Scheduling \sep PERT/CPM \sep Monte Carlo Simulation

\end{keyword}

